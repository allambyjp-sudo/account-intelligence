# Copy to .env for local development. Never commit .env. When hosted, set these as environment
# variables and secrets (see docs/deployment.md). docs/connecting.md explains each connection.

# --- Database ----------------------------------------------------------------------------------
# docker compose up -d gives you this database.
DATABASE_URL=postgres://aip:aip@localhost:5432/aip
# Integration tests create and drop their own schemas in this database.
TEST_DATABASE_URL=postgres://aip:aip@localhost:5432/aip_test

# --- Sign-in -----------------------------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=
# One-click local sign-in. Refused (the app won't start) when NODE_ENV=production.
AUTH_DEV_BYPASS=true
# Microsoft Entra ID, single tenant. See docs/entra-sign-in-setup.md. Set all four or none.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/callback

# --- Model layer -------------------------------------------------------------------------------
# anthropic (default) | conver (stub until its API is known) | mock (no network; dev and tests only)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Per-task overrides, e.g. a cheaper classifier once volumes are known:
# LLM_MODEL_CLASSIFY=claude-haiku-5-5
# LLM_EFFORT_RESEARCH=high
# Server-side refusal fallback (on by default). Set to off to disable.
# LLM_REFUSAL_FALLBACK=off
# Research's web-search pass (on when the provider supports it). Set to off to rely on adapters only.
# RESEARCH_WEB_SEARCH=off
CONVER_BASE_URL=
CONVER_API_KEY=
# mock (tests) | local (npm install @huggingface/transformers) | voyage
EMBEDDING_PROVIDER=mock
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3.5
# LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# --- External sources --------------------------------------------------------------------------
# Goes in the User-Agent so site owners can reach you. An email address or URL. Required.
CRAWLER_CONTACT=
ABN_LOOKUP_GUID=
NZBN_API_KEY=
# NZBN_API_BASE=https://api.business.govt.nz/gateway/nzbn/v5
ALPHA_VANTAGE_API_KEY=
# ALPHA_VANTAGE_SUFFIX_ASX=.AX
# ALPHA_VANTAGE_SUFFIX_NZX=.NZ
# ASX_COMPANIES_CSV_URL=https://www.asx.com.au/asx/research/ASXListedCompanies.csv
# Turn sources on or off by id (see /sources). asx_announcements is off until ASX's terms are checked.
# SOURCES_ENABLED=asx_announcements
# SOURCES_DISABLED=

# --- Email (Phase 6; real mailboxes need both switches below) -----------------------------------
# Your organisation's email domains. Mail only among these is never stored.
ORG_EMAIL_DOMAINS=seller.example
# IT has approved connecting real mailboxes.
MAILBOX_CONNECT_APPROVED=false
# For a personal test mailbox only: allow email processing without Conver.
# ALLOW_MAILBOX_WITHOUT_CONVER=true
# Seals mailbox tokens at rest. 32+ characters; falls back to SESSION_SECRET.
TOKEN_ENCRYPTION_KEY=
# HTTPS address of the app, for Outlook change notifications. Without it, mail syncs every 15 minutes.
PUBLIC_BASE_URL=
# Optional Gmail connector.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/connect/gmail/callback

# --- App ---------------------------------------------------------------------------------------
APP_TIMEZONE=Australia/Melbourne
# Shown as "<ORG_NAME> fit" in the brief.
ORG_NAME=Datacom
